# Contact form email delivery (Resend — free tier). Leave unset to keep the
# form closed. After changing these on Vercel, redeploy so the page updates.
RESEND_API_KEY=
# Optional. Inbox that receives contact form messages. Defaults to the
# official email in src/content/sources/local/site.json.
CONTACT_TO_EMAIL=
# Optional. Needs a domain verified in Resend; defaults to Resend's test
# sender, which only delivers to the Resend account owner's address.
CONTACT_FROM_EMAIL=

# Admin (/admin) — editing updates, articles and the gallery. No database:
# "Publish" commits the files to the GitHub repository and Vercel rebuilds.
# The shared sign-in password (at least 8 characters; use a long one).
ADMIN_PASSWORD=
# Fine-grained GitHub token with "Contents: Read and write" on this repository
# only. Without it (locally), the admin writes files straight into this folder.
ADMIN_GITHUB_TOKEN=
# Optional — detected automatically on Vercel. Format: owner/repository.
ADMIN_GITHUB_REPO=
# Optional — the branch Vercel deploys from. Default: main.
ADMIN_GITHUB_BRANCH=
